let write_list_to_file_generic (filename : string) (data : 'a list) (format : 'a -> string) =
  let oc = open_out filename in (* Ouvre le fichier en écriture *)
  List.iter (fun item ->
    output_string oc (format item ^ "\n") (* Utilise le format fourni pour chaque élément *)
  ) data;
  close_out oc (* Ferme le fichier *)
;;


let time_eval(myfunc, myparam : ('a -> 'b) * 'a) : float = 
  let mem_tm : float = Sys.time() in
    (
    ignore(myfunc(myparam)) ;
    Sys.time() -. mem_tm
    )
;;


let rev lst =
  List.fold_left (fun acc x -> x :: acc) [] lst
;;


let sort tab =
  let n = Array.length tab in

  (* Fonction pour échanger deux éléments du tableau *)
  let swap i j =
    let temp = tab.(i) in
    tab.(i) <- tab.(j);
    tab.(j) <- temp
  in

  (* Fonction pour réorganiser le sous-arbre en un tas maximum *)
  let rec heapify size i =
    let largest = ref i in
    let left = 2 * i + 1 in
    let right = 2 * i + 2 in

    (* Si le fils gauche est plus grand que le parent *)
    if left < size && fst tab.(left) > fst tab.(!largest) then
      largest := left;

    (* Si le fils droit est plus grand que le plus grand trouvé *)
    if right < size && fst tab.(right) > fst tab.(!largest) then
      largest := right;

    (* Si le plus grand n'est pas le parent, échange et réorganise *)
    if !largest <> i then (
      swap i !largest;
      heapify size !largest
    )
  in

  (* Construire le tas maximum *)
  let build_max_heap () =
    for i = (n / 2) - 1 downto 0 do
      heapify n i
    done
  in

  (* Trier le tableau en utilisant le tas *)
  let heap_sort () =
    build_max_heap ();
    for i = n - 1 downto 1 do
      swap 0 i;
      heapify i 0
    done
  in

  (* Appeler le tri *)
  heap_sort ();
  tab
;;


